# ── VV Brown Fragrances · Vercel env template (safe to commit — no secrets) ──
# 1. Copy to vercel.env.local (gitignored)
# 2. Fill values from Supabase + RedFace Pay dashboards
# 3. Paste into Vercel → Project → Settings → Environment Variables

# Required — Supabase (RedFace Pay production project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required — VV Brown merchant on RedFace Pay
NEXT_PUBLIC_VEEBROWN_MERCHANT_ID=44ea657f-217c-4700-9441-ad391a13e354

# Required — RedFace Pay + checkout API
NEXT_PUBLIC_REDFACE_PAY_URL=https://www.redfacepay.co.za
NEXT_PUBLIC_REDFACE_COMMERCE_API=https://bpzzgilwlkghgfkvkkxx.supabase.co/functions/v1/ecosystem-commerce

# Required — canonical site URL (update after Vercel assigns domain)
NEXT_PUBLIC_SITE_URL=https://veebrown.vercel.app

# Optional — only if ecosystem-commerce returns 401 on checkout
# ECOSYSTEM_API_KEY=

# Optional — not used on fragrance site (try-on routes redirect to /shop)
# OPENROUTER_API_KEY=
